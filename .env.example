# Wajib untuk fitur AI — ambil di https://aistudio.google.com/apikey (gratis)
GEMINI_API_KEY=
# Opsional — ganti model kalau yang default sudah deprecated
GEMINI_MODEL=gemini-3.1-flash-lite-preview
# Opsional
PORT=3000

# --- DEPLOY (Koyeb/host lain) — data persisten via Turso (gratis, tanpa kartu) ---
# 1. https://turso.tech → login GitHub → `turso db create ryora`
# 2. `turso db show ryora --url` → TURSO_URL=libsql://ryora-xxx.turso.io
# 3. `turso db tokens create ryora` → TURSO_TOKEN=eyJ...
# Tanpa dua var ini, app tetap jalan tapi DB lokal (ilang saat redeploy).
TURSO_URL=
TURSO_TOKEN=
